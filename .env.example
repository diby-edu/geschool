# =============================================================================
#  SaaS Gestion Scolaire — variables d'environnement
# =============================================================================
#  Copier ce fichier en .env.local puis remplir les valeurs.
#      cp .env.example .env.local
#
#  .env.local n'est JAMAIS commité (il est dans .gitignore).
#  Seul ce fichier-ci, sans aucun secret, vit dans le dépôt.
#
#  Les variables préfixées NEXT_PUBLIC_ sont envoyées au navigateur :
#  n'y mettre AUCUN secret, jamais.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. SUPABASE
#     Dashboard Supabase > Settings > API
# -----------------------------------------------------------------------------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé "anon public" — sûre côté navigateur, la RLS fait le travail
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRET ABSOLU. Contourne toute la RLS.
# Utilisée uniquement par src/lib/supabase/admin.ts et les workers (ADR-013).
# Ne jamais l'exposer côté client, ne jamais la logger.
SUPABASE_SERVICE_ROLE_KEY=

# Chaîne de connexion Postgres — utilisée UNIQUEMENT par les migrations
# (pnpm db:migrate) et par pg-boss. L'application passe par l'API Supabase.
#
# Dashboard > Connect > Connection String > onglet URI, choisir "Session pooler"
#   port 5432, hôte *.pooler.supabase.com  -> compatible IPv4, c'est celui-là
# Éviter :
#   "Transaction pooler" (6543) : incompatible avec les migrations et pg-boss
#   "Direct connection"         : IPv6 uniquement, échoue depuis le VPS
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres


# -----------------------------------------------------------------------------
#  2. APPLICATION
# -----------------------------------------------------------------------------

# URL publique, sans slash final.
#   développement : http://localhost:3000
#   production    : https://geschool.numerik360.com
# Sert aux liens des SMS d'identifiants, aux emails et aux URLs absolues des PDF.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nom affiché de la plateforme (marque blanche possible par établissement)
NEXT_PUBLIC_PLATFORM_NAME=Gestion Scolaire

NODE_ENV=development

# Port interne et interface d'écoute. En production, 127.0.0.1 impérativement :
# l'app n'est joignable que par nginx, jamais directement depuis Internet.
PORT=3000
HOSTNAME=127.0.0.1


# -----------------------------------------------------------------------------
#  3. VALEURS PAR DÉFAUT À LA CRÉATION D'UN ÉTABLISSEMENT (ADR-004)
#     Ce ne sont que des défauts : chaque établissement peut tout redéfinir.
# -----------------------------------------------------------------------------

DEFAULT_COUNTRY_CODE=CI
DEFAULT_LOCALE=fr-CI
DEFAULT_TIMEZONE=Africa/Abidjan
DEFAULT_CURRENCY=XOF

# Indicatif utilisé pour normaliser en E.164 un numéro saisi en format local
# (0101010101 -> +2250101010101). Voir ACCESS_MANAGEMENT.md §2.
DEFAULT_PHONE_COUNTRY=CI


# -----------------------------------------------------------------------------
#  4. AMORÇAGE DE LA PLATEFORME
# -----------------------------------------------------------------------------

# Emails des Super Admins créés par le seed initial, séparés par des virgules.
# Ces comptes reçoivent un accès total en lecture/écriture sur tous les
# établissements (ADR-007) et la MFA leur est imposée.
PLATFORM_ADMIN_EMAILS=

# Domaine des identités synthétiques Supabase Auth (ADR-005).
# .invalid est réservé par la RFC 2606 : aucun email ne peut y être livré.
# NE PAS CHANGER après la mise en production : les comptes existants en dépendent.
AUTH_SYNTHETIC_EMAIL_DOMAIN=accounts.invalid


# -----------------------------------------------------------------------------
#  5. SERVICE SOLVEUR (OR-Tools CP-SAT) — phase 5
# -----------------------------------------------------------------------------

# URL interne du service Python. Jamais exposé à Internet.
#   développement : http://127.0.0.1:8000
#   production    : http://127.0.0.1:8110
SOLVER_SERVICE_URL=http://127.0.0.1:8000

# Secret partagé entre Next.js et le solveur (en-tête X-Solver-Secret).
# Générer avec :  openssl rand -hex 32
# Doit être IDENTIQUE dans la section 12 (environnement du conteneur solveur).
SOLVER_SHARED_SECRET=

# Plafond de temps par défaut d'une génération, en secondes.
# Surchargeable par établissement dans school_settings.schedule.
SOLVER_DEFAULT_TIMEOUT_SECONDS=120

# Nombre de générations simultanées sur tout le serveur, tous établissements
# confondus. Le VPS n'ayant qu'un seul vCPU, laisser à 1 (ADR-014).
SOLVER_MAX_CONCURRENT_JOBS=1

# Charge système (moyenne 1 min) au-delà de laquelle une génération est DIFFÉRÉE
# plutôt que lancée. Protège les 8 autres sites du VPS. 0 = désactivé.
SOLVER_MAX_LOAD_AVERAGE=1.2

# Délai de report quand la charge est trop élevée, en secondes
SOLVER_LOAD_RETRY_DELAY_SECONDS=180


# -----------------------------------------------------------------------------
#  6. FILE DE JOBS (pg-boss)
# -----------------------------------------------------------------------------

# Schéma Postgres dédié à pg-boss, isolé des tables métier
PGBOSS_SCHEMA=pgboss

# Jobs traités en parallèle par le worker. Sur 1 vCPU, rester bas.
WORKER_CONCURRENCY=2

# Mettre à false sur les instances qui ne doivent pas consommer de jobs
# (utile si l'app web et le worker tournent séparément)
WORKER_ENABLED=true


# -----------------------------------------------------------------------------
#  7. SMS — transmission des identifiants UNIQUEMENT (ADR-010)
#     Aucune notification scolaire ne passe par SMS.
# -----------------------------------------------------------------------------

# console | orange_ci | letexto | twilio
#   console = écrit le message dans les logs, ne consomme rien. Défaut en dev.
SMS_PROVIDER=console

SMS_API_KEY=
SMS_API_SECRET=

# Nom d'expéditeur affiché sur le téléphone (souvent 11 caractères max,
# à faire enregistrer chez l'opérateur)
SMS_SENDER_ID=

# Secret de validation des webhooks d'accusé de réception (SENT -> DELIVERED)
SMS_WEBHOOK_SECRET=

# Garde-fous anti-dérapage de facture. 0 = illimité.
SMS_MAX_PER_MINUTE=20
SMS_MAX_PER_DAY=2000


# -----------------------------------------------------------------------------
#  8. GÉNÉRATION PDF (bulletins, listes, emplois du temps)
# -----------------------------------------------------------------------------

# Chemin du binaire Chromium. Vide = Playwright utilise le sien.
# Sur le VPS, préférer le Chromium système pour économiser 300 Mo par install.
CHROMIUM_EXECUTABLE_PATH=

# Rendus PDF simultanés. Sur 1 vCPU / 3,8 Go, ne pas dépasser 1.
PDF_MAX_CONCURRENCY=1


# -----------------------------------------------------------------------------
#  9. SÉCURITÉ
# -----------------------------------------------------------------------------

# Secret protégeant les routes de tâches planifiées (en-tête Authorization).
# Générer avec :  openssl rand -hex 32
CRON_SECRET=

# Limitation de débit applicative (en complément de nginx)
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_SYNC_PER_MINUTE=60

# Taille maximale d'un fichier téléversé, en mégaoctets
UPLOAD_MAX_SIZE_MB=10


# -----------------------------------------------------------------------------
#  10. STOCKAGE (Supabase Storage)
#      Buckets privés. Arborescence imposée : schools/{school_id}/...
# -----------------------------------------------------------------------------

STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_REPORTS=reports

# Durée de validité d'une URL signée, en secondes (900 = 15 min)
STORAGE_SIGNED_URL_TTL=900


# -----------------------------------------------------------------------------
#  11. OBSERVABILITÉ (facultatif)
# -----------------------------------------------------------------------------

# Sentry > Settings du projet > Client Keys (DSN). Public par nature.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry > Settings > Auth Tokens — upload des source maps au build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# debug | info | warn | error
LOG_LEVEL=info


# =============================================================================
#  12. ENVIRONNEMENT DU CONTENEUR SOLVEUR
#      À reporter dans solver-service/.env (phase 5), pas lu par Next.js.
#      Le solveur ne reçoit AUCUNE variable Supabase : il n'a structurellement
#      aucun moyen d'atteindre la base (SOLVER_API.md §10).
# =============================================================================
#
# SOLVER_PORT=8000
# SOLVER_HOST=127.0.0.1
# SOLVER_SHARED_SECRET=            <- doit être identique à la section 5
# SOLVER_MAX_WORKERS=1             <- 1 seul vCPU sur le VPS : ne pas augmenter
# SOLVER_MAX_PAYLOAD_MB=8
# SOLVER_LOG_LEVEL=info

# =============================================================================
# 12. Couche IA (lot 13) — FACULTATIF
# =============================================================================
# Sans cle, l'assistant d'appreciation fonctionne en mode deterministe (regles),
# sans aucun appel externe ni envoi de donnees. Avec une cle, il s'appuie sur le
# LLM et retombe sur les regles en cas d'erreur. L'IA n'accede JAMAIS a la base :
# elle ne transforme que des donnees deja retournees a l'utilisateur.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_TIMEOUT_SECONDS=20
